  "name": "Aurora Dark",
  "semanticHighlighting": true,
  "tokenColors": [
    {
      "scope": "comment",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#7e86a0"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#a6d279"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage"
      ],
      "settings": {
        "foreground": "#d2a6f2"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#89b6f5"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#ffac70"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.name.class"
      ],
      "settings": {
        "foreground": "#89d7e6"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#c6cbdd"
      }
    },
    {
      "scope": "support.type.property-name.json",
      "settings": {
        "foreground": "#89b6f5"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#c6cbdd"
      }
    }
  ],
  "type": "dark"
}
