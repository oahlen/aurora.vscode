  "name": "Aurora Light",
  "semanticHighlighting": true,
  "tokenColors": [
    {
      "scope": "comment",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#68718d"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#407010"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage"
      ],
      "settings": {
        "foreground": "#884fb0"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#376fbe"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#a34400"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.name.class"
      ],
      "settings": {
        "foreground": "#137386"
      }
    },
    {
